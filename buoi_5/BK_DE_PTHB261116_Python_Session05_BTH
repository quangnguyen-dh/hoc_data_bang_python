so_nv = int(input("Nhập số lượng nhân viên: "))
for nv_so in range(1, so_nv+1):
    ten_nv = input("Nhập tên nhân viên: ")
    so_ngay_lm = int(input("Nhập số ngày làm: "))
    if(so_ngay_lm<0 and so_ngay_lm>22):
        print("Dữ liệu không hợp lệ")
        continue
    elif(so_ngay_lm==0):
        print("Nhân viên nghỉ toàn bộ tháng")
    print(ten_nv+": ", end="")
    for i in range(1,so_ngay_lm+1):
        print("*", end="")
    print()
    if(so_ngay_lm>=18):
        print("Làm việc chăm chỉ")
    elif(so_ngay_lm<10):
        print("Làm việc ít")
    else:
        print("Làm việc bình thường")
