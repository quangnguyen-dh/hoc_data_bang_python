import random
import sys
so_dep = random.randint(1, 100)
for ngay in range(1,11):
    print("Lượt đoán", str(ngay)+" - ", end=" ")
    so_doan = int(input("Nhập số của bạn: "))
    if(so_doan!=so_dep):
        if(so_doan>so_dep):
            print("==> Gợi ý: Số của bạn lớn hơn số may mắn!")
        else:
            print("==> Gợi ý: Số của bạn nhỏ hơn số may mắn!")
    else:
        print("==> Chúc mừng! Bạn đã đoán đúng chính xác mã số may mắn!")
        print("    Chúc mừng bạn đã trúng giải thưởng quà đặc biệt!")
        print("--- TRÒ CHƠI KẾT THÚC ---")
        sys.exit(0)
print("Bạn đã dùng hết lượt chơi ở lần này. Chúc mừng bạn may mắn lần sau!")
