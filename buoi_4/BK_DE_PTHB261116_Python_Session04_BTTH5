tiep_khong = "C"
dem=0
tong_tien=0
so_hoa_don_lon=0
ti_le_hoa_don_lon=0
while(tiep_khong=="C"):
    dem=dem+1
    print("Khách hàng", dem, "- nhập giá trị đơn:",end=" ")
    gia_tri_hoa_don = int(input())
    tong_tien = tong_tien + gia_tri_hoa_don
    if(gia_tri_hoa_don>1000000): so_hoa_don_lon = so_hoa_don_lon + 1
    tiep_khong = input("Có muốn nhập tiếp không? (C/K): ")
    print()
ti_le_hoa_don_lon = (so_hoa_don_lon/dem)*100
print("--- BÁO CÁO DOANH THU CUỐI NGÀY RIKKEI STORE ---")
print("Tổng số hóa đơn đã sử lý:", dem, "hóa đơn.")
print("Tổng doanh thu ngày hôm nay:", f"{format(tong_tien, ',')} VND.")
print("Số hóa đơn (>= 1,000,000 VND):", so_hoa_don_lon, "hóa đơn.")
print("Tỉ lệ hóa đơn lớn đạt:", str(ti_le_hoa_don_lon)+"%", "trên tổng số đơn hàng.")
