import sys


i=1
while(i>0):
    print("--- HỆ THỐNG KHAI BÁO NHÂN SỰ MỚI ---")
    i=i-1
    so_luong_vn = input("Nhập số lượng nhân viên trong tháng này: ").strip()
    if(so_luong_vn=="" or int(so_luong_vn)<=0 ):
        i=i+1
        print("[LỖI] số lượng không hợp lệ! vui lòng nhập một con số mới lớn hơn 0.")
        print()
        continue
    print("[THÀNH CÔNG] Đã ghi nhận yêu cầu phát tài sản cho", so_luong_vn, "nhân sự mới!")
    print("--- CHƯƠNG TRÌNH KẾT THÚC ---")
sys.exit()
