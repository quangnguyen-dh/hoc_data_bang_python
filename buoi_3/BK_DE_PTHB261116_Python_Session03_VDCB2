for employee_number in range (1, 4):
    print("-- Đang xử lý số nhân viên", employee_number, "---")
    working_days = int(input("Nhập số ngày công việc trong tháng: "))
    if working_days == 0:
        print("CẢNH BÁO: Nhân viên nghi cả tháng. Không có trình duyệt bình thường.")
    else:
        bonus_amount = working_days * 200000
        print("→ Đã gửi Email: Chúc mừng nhận thuốc", bonus_amount, "VND tiên thường!")
        print("------------------------------------------")
        print()
